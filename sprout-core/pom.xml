<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.sprout</groupId>
    <artifactId>sprout-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <!-- The Sprout framework itself. A user's app depends on this, like "react". -->
  <artifactId>sprout-core</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Browser/DOM bindings. compile scope so it's transitive to apps that use Sprout. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Compiles the DOM tests to wasm and runs them in a real browser;
         @RunWith(TeaVMTestRunner.class) marks which ones. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- TeaVM's class-library emulation. Without it the test compiler cannot
         resolve lambdas (LambdaMetafactory) and every DOM test fails to build. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <!-- Pure-logic tests run on the JVM. The DOM tests compile to WasmGC
                 and run in headless Chrome; set -Dteavm.junit.wasm-gc=false to
                 skip them (CI without a browser). -->
            <teavm.junit.wasm-gc>${sprout.browserTests}</teavm.junit.wasm-gc>
            <teavm.junit.wasm-gc.runner>browser-chrome</teavm.junit.wasm-gc.runner>
            <!-- wasm is what we ship; compiling the JS target too would leave a
                 platform with no runner and NPE in the runner's teardown. -->
            <teavm.junit.js>false</teavm.junit.js>
            <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
          </systemPropertyVariables>
          <environmentVariables>
            <!-- TeaVM launches the browser as bare `chrome`, so it must be on PATH.
                 Override with -Dchrome.dir=/path/to/chrome-dir if yours lives elsewhere. -->
            <PATH>${env.PATH}${path.separator}${chrome.dir}</PATH>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
